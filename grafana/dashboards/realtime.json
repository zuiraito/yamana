        "type": "grafana-postgresql-datasource",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, altitude_m FROM aprs_telemetry WHERE $__timeFilter(time) ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "lengthm",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "–",
          "decimals": 0
